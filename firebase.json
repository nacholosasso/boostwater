{
  "hosting": {
    "site": "boostwaterarg",
    "public": "public",
    "predeploy": [
      "npx tailwindcss -i ./src/input.css -o ./public/css/style.css"
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ]
}
